{
  "departments": ["Engineering", "Sales", "Human Resources", "IT", "Facilities", "Compliance"],
  "locations": {
    "Bengaluru": "IN", "Pune": "IN", "Mumbai": "IN", "Hyderabad": "IN",
    "New York": "US", "Austin": "US"
  },
  "roles": [
    {"role": "Software Engineer", "department": "Engineering", "grade": "G3"},
    {"role": "Senior Software Engineer", "department": "Engineering", "grade": "G5"},
    {"role": "Software Engineering Intern", "department": "Engineering", "grade": "G1"},
    {"role": "Solutions Architect", "department": "Engineering", "grade": "G5"},
    {"role": "QA Engineer", "department": "Engineering", "grade": "G2"},
    {"role": "Account Executive", "department": "Sales", "grade": "G3"},
    {"role": "Sales Development Representative", "department": "Sales", "grade": "G2"},
    {"role": "HR Business Partner", "department": "Human Resources", "grade": "G4"}
  ],
  "doc_types": {
    "photo_id": {"name": "Government photo ID (Passport / Aadhaar / Driver's licence)", "fields": ["full_name", "document_number", "date_of_birth"], "expires": true},
    "address_proof": {"name": "Address proof (utility bill / rental agreement / Aadhaar)", "fields": ["full_name", "address"], "expires": false},
    "pan_card": {"name": "PAN card", "fields": ["full_name", "document_number", "date_of_birth"], "expires": false},
    "education_certificate": {"name": "Highest education certificate", "fields": ["full_name", "issue_date"], "expires": false},
    "experience_letter": {"name": "Relieving / experience letter from last employer", "fields": ["full_name", "issue_date"], "expires": false},
    "i9_documents": {"name": "Form I-9 supporting documents", "fields": ["full_name", "document_number"], "expires": true},
    "w4_form": {"name": "Form W-4 (signed)", "fields": ["full_name"], "expires": false},
    "bank_details": {"name": "Cancelled cheque / bank letter", "fields": ["full_name", "document_number"], "expires": false}
  },
  "rules": [
    {"id": "R-ID", "item": "photo_id", "kind": "document", "category": "HR", "match": {}, "offset_days": -10,
     "description": "Identity documents are required for all employees before joining", "policy_ref": "document-submission-policy.md"},
    {"id": "R-ADDR", "item": "address_proof", "kind": "document", "category": "HR", "match": {}, "offset_days": -10,
     "description": "Address proof is required for all employees before joining", "policy_ref": "document-submission-policy.md"},
    {"id": "R-PAN", "item": "pan_card", "kind": "document", "category": "HR", "match": {"country": "IN"}, "offset_days": -10,
     "description": "PAN is mandatory for payroll tax registration for India-based employees", "policy_ref": "document-submission-policy.md"},
    {"id": "R-BANK", "item": "bank_details", "kind": "document", "category": "HR", "match": {"country": "IN"}, "offset_days": -5,
     "description": "Bank details are needed to set up salary credit for India payroll", "policy_ref": "document-submission-policy.md"},
    {"id": "R-EDU", "item": "education_certificate", "kind": "document", "category": "HR", "match": {"department": "Engineering"}, "offset_days": -10,
     "description": "Engineering roles specify a minimum qualification, so the highest education certificate is required", "policy_ref": "document-submission-policy.md"},
    {"id": "R-EXP", "item": "experience_letter", "kind": "document", "category": "HR", "match": {"grade_min": 3}, "offset_days": -7,
     "description": "Lateral hires at grade G3 and above must provide a relieving letter from their previous employer", "policy_ref": "document-submission-policy.md"},
    {"id": "R-I9", "item": "i9_documents", "kind": "document", "category": "HR", "match": {"country": "US"}, "offset_days": 3,
     "description": "US federal law requires Form I-9 verification within 3 business days of the start date", "policy_ref": "us-onboarding-policy.md"},
    {"id": "R-W4", "item": "w4_form", "kind": "document", "category": "HR", "match": {"country": "US"}, "offset_days": -3,
     "description": "A signed W-4 is required to set up US federal tax withholding", "policy_ref": "us-onboarding-policy.md"},

    {"id": "R-BGV", "item": "background_verification", "name": "Background verification", "kind": "task", "category": "Compliance", "match": {}, "offset_days": -4,
     "depends_on": ["photo_id", "address_proof", "education_certificate", "experience_letter"],
     "description": "Background verification is required before system access is granted", "policy_ref": "background-verification-policy.md"},
    {"id": "R-HRREC", "item": "hr_record", "name": "Create HR record", "kind": "task", "category": "HR", "match": {}, "offset_days": -5, "auto": "complete",
     "depends_on": ["photo_id", "address_proof", "pan_card", "bank_details", "w4_form"],
     "description": "The employee record is created once identity and payroll documents are accepted", "policy_ref": "it-provisioning-guide.md"},
    {"id": "R-LAPTOP", "item": "laptop", "name": "Laptop provisioning", "kind": "task", "category": "IT", "match": {}, "offset_days": -2, "auto": "request",
     "depends_on": ["hr_record"],
     "description": "Laptop and email provisioning are requested after the HR record is created", "policy_ref": "it-provisioning-guide.md"},
    {"id": "R-EMAIL", "item": "email_account", "name": "Corporate email account", "kind": "task", "category": "IT", "match": {}, "offset_days": -2, "auto": "request",
     "depends_on": ["hr_record"],
     "description": "Laptop and email provisioning are requested after the HR record is created", "policy_ref": "it-provisioning-guide.md"},
    {"id": "R-INFOSEC", "item": "infosec_ack", "name": "Information security policy acknowledgement", "kind": "ack", "category": "Compliance", "match": {}, "offset_days": -1,
     "description": "Information security acknowledgement is required before access to production systems", "policy_ref": "information-security-policy.md"},
    {"id": "R-COC", "item": "coc_ack", "name": "Code of conduct acknowledgement", "kind": "ack", "category": "HR", "match": {}, "offset_days": 0,
     "description": "All employees must acknowledge the code of conduct on or before day one", "policy_ref": "code-of-conduct.md"},
    {"id": "R-DEVTOOLS", "item": "dev_tools", "name": "Developer tools access (GitHub, Jira, AWS)", "kind": "task", "category": "IT", "match": {"department": "Engineering"}, "offset_days": 1, "auto": "request",
     "depends_on": ["email_account", "background_verification", "infosec_ack"],
     "description": "Engineering roles need development tool access, granted only after BGV and security acknowledgement", "policy_ref": "it-provisioning-guide.md"},
    {"id": "R-CRM", "item": "crm_access", "name": "CRM access (Salesforce)", "kind": "task", "category": "IT", "match": {"department": "Sales"}, "offset_days": 1, "auto": "request",
     "depends_on": ["email_account", "background_verification"],
     "description": "Sales roles need CRM access after the email account and BGV are complete", "policy_ref": "it-provisioning-guide.md"},
    {"id": "R-BADGE", "item": "id_badge", "name": "Office access badge & desk", "kind": "task", "category": "Facilities", "match": {}, "offset_days": -1, "auto": "request",
     "depends_on": ["hr_record"],
     "description": "Facilities issues a badge and desk once the HR record exists", "policy_ref": "first-day-guide.md"},
    {"id": "R-ORIENT", "item": "orientation", "name": "Day-one orientation session", "kind": "task", "category": "HR", "match": {}, "offset_days": 0,
     "depends_on": ["laptop", "id_badge"],
     "description": "Every new joiner attends orientation on day one", "policy_ref": "first-day-guide.md"}
  ]
}
