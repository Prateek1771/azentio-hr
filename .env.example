# Runtime. ENV=production makes DATABASE_URL, ADMIN_EMAIL and ADMIN_PASSWORD required and disables dev seed users.
ENV=development
DATABASE_URL=postgresql://azentio:azentio@localhost:5432/azentio
# First admin, created on startup if missing (never overwrites an existing password)
ADMIN_EMAIL=admin@azentio.local
ADMIN_PASSWORD=
SESSION_DAYS=7
# Set true when served over https
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Connector secrets at rest (ADR 0013). Required in production once any connector has credentials; dev falls back to a
# built-in key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: set SECRETS_KEY=<new> and SECRETS_KEY_PREVIOUS=<old>, run `uv run python -m connectors.rotate_key`,
# then remove SECRETS_KEY_PREVIOUS.
SECRETS_KEY=
SECRETS_KEY_PREVIOUS=

# LLM: any OpenAI-compatible provider. Defaults to OpenRouter free models.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free
LLM_EMBED_MODEL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
HR_MAILBOX=
AWAITVERIFY_API_KEY=
AWAITVERIFY_ENABLED=false
FALKORDB_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:3000

# Demo: send every candidate email to this one inbox instead (subject keeps the original address)
EMAIL_REDIRECT_TO=
# Console log level for the key=value request/event lines
LOG_LEVEL=INFO

# Langfuse LLM tracing (optional; off unless both keys are set). Cloud or self-hosted.
# Document images are redacted before export; prompt text (names, policy chunks) is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Ragas evaluation judge (Quality page / `uv run python evals.py`). Defaults to the app's LLM settings.
RAGAS_JUDGE_MODEL=
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_API_KEY=

# Optional free fallbacks, used in order when OpenRouter's free quota (50 requests/day) runs out.
# Groq: console.groq.com/keys   Gemini: aistudio.google.com/apikey   Cerebras: cloud.cerebras.ai
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
