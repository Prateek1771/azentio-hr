# LLM: any OpenAI-compatible provider. Defaults to OpenRouter free models.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free
LLM_EMBED_MODEL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
HR_MAILBOX=
AWAITVERIFY_API_KEY=
AWAITVERIFY_ENABLED=false
FALKORDB_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:3000

# Demo: send every candidate email to this one inbox instead (subject keeps the original address)
EMAIL_REDIRECT_TO=
# Console log level for the key=value request/event lines
LOG_LEVEL=INFO
